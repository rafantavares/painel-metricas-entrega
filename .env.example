# Copie este arquivo para `.env` e preencha os valores. Nunca commite o `.env`.

# Token pessoal do GitHub (somente leitura basta: escopo `public_repo` ou fine-grained com
# permissão de leitura em Issues, Pull requests e Metadata).
GITHUB_TOKEN=

# Repositórios a analisar, no formato dono/repo, separados por vírgula.
PAINEL_REPOSITORIOS=rafantavares/painel-metricas-entrega

# Caminho do arquivo DuckDB gerado pelo coletor.
PAINEL_BANCO=data/painel.duckdb
