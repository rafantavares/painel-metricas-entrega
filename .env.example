# Copie este arquivo para `.env` e preencha os valores. Nunca commite o `.env`.

# Token pessoal do GitHub (somente leitura basta: escopo `public_repo` ou fine-grained com
# permissão de leitura em Issues, Pull requests e Metadata).
GITHUB_TOKEN=

# Repositórios a analisar, no formato dono/repo, separados por vírgula.
PAINEL_REPOSITORIOS=rafantavares/painel-metricas-entrega

# Caminho do arquivo DuckDB gerado pelo coletor.
PAINEL_BANCO=data/painel.duckdb

# Como identificar deploys, por repositório (ver docs/adr/0004-regra-de-deploy.md).
# Formato: dono/repo=regra, separados por ponto e vírgula. Regras aceitas:
#   release                       releases publicadas (padrão para repositórios não listados)
#   tag[:padrão]                  tags cujo nome casa com o padrão glob (ex.: tag:v*)
#   workflow:arquivo.yml[@branch] execuções bem-sucedidas do workflow (branch padrão: main)
# Exemplo: PAINEL_REGRAS_DEPLOY=dono/api=workflow:deploy.yml@main; dono/app=tag:v*
PAINEL_REGRAS_DEPLOY=
